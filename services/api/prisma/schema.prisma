generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String             @id @default(uuid())
  email             String             @unique
  passwordHash      String
  fullName          String?
  firstName         String?
  lastName          String?
  role              UserRole           @default(STUDENT)
  points            Int                @default(0)
  createdAt         DateTime           @default(now())
  lastLoginAt       DateTime?
  courses           Course[]
  enrollments       Enrollment[]
  grades            Grade[]
  payments          Payment[]
  practiceSessions  PracticeSession[]
  progressSnapshots ProgressSnapshot[]
  subscriptions     Subscription[]
}

model Quiz {
  id           String     @id @default(uuid())
  courseId     String
  title        String
  description  String?
  passingScore Int        @default(60)
  rewardPoints Int        @default(100)
  lessonId     String
  grades       Grade[]
  questions    Question[]
  course       Course     @relation(fields: [courseId], references: [id])
  lesson       Lesson     @relation(fields: [lessonId], references: [id])
}

model Question {
  id      String @id @default(uuid())
  quizId  String
  content String
  options Json
  answer  String
  points  Int    @default(10)
  quiz    Quiz   @relation(fields: [quizId], references: [id])
}

model Grade {
  id          String   @id @default(uuid())
  userId      String
  quizId      String
  score       Int
  totalPoints Int
  passed      Boolean
  createdAt   DateTime @default(now())
  quiz        Quiz     @relation(fields: [quizId], references: [id])
  user        User     @relation(fields: [userId], references: [id])
}

model Subscription {
  id        String             @id @default(uuid())
  userId    String
  plan      SubscriptionPlan   @default(FREE)
  status    SubscriptionStatus @default(ACTIVE)
  startedAt DateTime           @default(now())
  endedAt   DateTime?
  user      User               @relation(fields: [userId], references: [id])
}

model Course {
  id           String       @id @default(uuid())
  title        String
  description  String?
  category     Category
  level        Level
  instructorId String
  published    Boolean      @default(false)
  createdAt    DateTime     @default(now())
  instructor   User         @relation(fields: [instructorId], references: [id])
  enrollments  Enrollment[]
  lessons      Lesson[]
  quizzes      Quiz[]
}

model Lesson {
  id                String             @id @default(uuid())
  title             String
  description       String?
  orderIndex        Int
  courseId          String
  createdAt         DateTime           @default(now())
  course            Course             @relation(fields: [courseId], references: [id])
  assets            LessonAsset[]
  blocks            LessonBlock[]
  practiceSessions  PracticeSession[]
  progressSnapshots ProgressSnapshot[]
  quizzes           Quiz[]
}

model LessonBlock {
  id         String       @id @default(uuid())
  lessonId   String
  type       BlockType
  orderIndex Int
  content    String?
  assetId    String?
  practiceId String?
  asset      LessonAsset? @relation(fields: [assetId], references: [id])
  lesson     Lesson       @relation(fields: [lessonId], references: [id])
}

model LessonAsset {
  id       String        @id @default(uuid())
  lessonId String
  type     AssetType
  url      String
  metadata Json?
  lesson   Lesson        @relation(fields: [lessonId], references: [id])
  blocks   LessonBlock[]
}

model Enrollment {
  id         String   @id @default(uuid())
  userId     String
  courseId   String
  enrolledAt DateTime @default(now())
  completed  Boolean  @default(false)
  course     Course   @relation(fields: [courseId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, courseId])
}

model PracticeSession {
  id           String          @id @default(uuid())
  lessonId     String
  userId       String?
  title        String
  instructions String?
  type         PracticeType
  correctData  Json
  musicXmlUrl  String?
  events       PracticeEvent[]
  lesson       Lesson          @relation(fields: [lessonId], references: [id])
  user         User?           @relation(fields: [userId], references: [id])
}

model PracticeEvent {
  id             String          @id @default(uuid())
  sessionId      String
  eventType      EventType
  note           String?
  expectedTimeMs Int
  actualTimeMs   Int
  velocity       Int?
  createdAt      DateTime        @default(now())
  session        PracticeSession @relation(fields: [sessionId], references: [id])
}

model ProgressSnapshot {
  id                   String   @id @default(uuid())
  userId               String
  lessonId             String
  avgAccuracy          Float
  totalPracticeSeconds Int
  lastPracticedAt      DateTime @default(now())
  lesson               Lesson   @relation(fields: [lessonId], references: [id])
  user                 User     @relation(fields: [userId], references: [id])

  @@unique([userId, lessonId])
}

model Payment {
  id        String          @id @default(uuid())
  userId    String
  provider  PaymentProvider
  amount    Int
  currency  String          @default("KRW")
  status    PaymentStatus
  createdAt DateTime        @default(now())
  user      User            @relation(fields: [userId], references: [id])
}

enum UserRole {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum SubscriptionPlan {
  FREE
  BASIC
  PRO
  INSTITUTION
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELED
}

enum Category {
  PIANO
  VOCAL
  THEORY
  COMPOSITION
}

enum Level {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum BlockType {
  TEXT
  VIDEO
  IMAGE
  PDF
  MUSIC_SCORE
  PRACTICE_TOOL
  QUIZ
  AUDIO
}

enum AssetType {
  VIDEO
  PDF
  MIDI
  MUSICXML
  AUDIO
}

enum PracticeType {
  MIDI_MATCH
  MULTIPLE_CHOICE
  EAR_TRAINING
}

enum Device {
  KEYBOARD
  MIC
  TOUCH
}

enum EventType {
  NOTE_ON
  NOTE_OFF
  ERROR
  TEMPO_DEVIATION
}

enum PaymentProvider {
  STRIPE
  PAYPAL
}

enum PaymentStatus {
  PAID
  FAILED
  REFUNDED
}
